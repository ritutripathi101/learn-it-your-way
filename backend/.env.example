# Copy this file to .env and fill in your own values. Never commit .env.
# A blank line like KEY= is read as an empty value, not as "use the default",
# so leave the defaults below in place unless you want to change them.

# Required for generation. Backend only, never in the browser. Use your own key.
GEMINI_API_KEY=

# Gemini model name. Make sure it is valid for your key.
GEMINI_MODEL=gemini-3.8-flash

# Used once if the main model is busy.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Signs login tokens. Set a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a local secret is created in backend/.jwt_secret (development only).
JWT_SECRET=

# Comma-separated allowed browser origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Location of the SQLite file. Default: backend/learn_it.db. Uncomment to change.
# DATABASE_PATH=/absolute/path/to/learn_it.db

# New study packs per user per 24 hours. Failed attempts are not counted.
GENERATIONS_PER_DAY=15

# Page limit for PDFs.
MAX_PDF_PAGES=400

# Longest wait for the AI step, in seconds.
AI_TIMEOUT_SECONDS=150

# Sign-in and sign-up attempts per IP per 15 minutes.
LOGIN_ATTEMPTS_PER_15_MIN=15
